namespace OstatniaRata.OstatniaRata.Core.Characters;

public class Monster
{
    
    
    
    
    public bool ChanceOfBeing(int chance)
    {
        bool is_Alive = false;
        Random random = new Random();
        int x = random.Next(0, chance);
        if (x > 3)
        {
            is_Alive = true;
        }
        else
        {
            is_Alive = false;
        }
        return is_Alive;
    }
}

